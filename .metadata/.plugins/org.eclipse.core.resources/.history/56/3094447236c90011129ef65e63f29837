
public class PrintFClass {
	
	public static void main(String[] args) {
		
		// 형식 문자열 출력
		/*
		 * 형식 문자열 출력이란, 데이터를 출력할 때 특정 형식에 맞춰 출력해야 하는 경우에 사용한다.
		 * System.out.printf();
		 */
		
		String name = "Mr. Hong";
		
		// 이름: Mr. Hong
		System.out.println("이름: " + name);
		System.out.printf("이름: %s", name);
		
		/*
		 * "이름: %s" --> 형식
		 * %s --> 지정자
		 */
		
		// 이름: 홍길동, 주소: 대전
		String uName = "홍길동";
		String uAddr = "대전";
		System.out.println("이름: %s, 주소: %s", uName, uAddr);
	}

}
