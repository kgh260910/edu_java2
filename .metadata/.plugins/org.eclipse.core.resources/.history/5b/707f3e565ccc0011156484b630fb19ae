
public class LoopEx {

	public static void main(String[] args) {
		
		// 안녕하세요.를 5회 출력하자!
		// for(초기화; 조건식; 단계)
		// for(시작; 끝; 단계)
		
		for (int i = 1; i < 4; i++) {
			System.out.println("안녕하세요" + i);
		}
		
		int i = 1;					// 전역 변수 i
		for (; i < 10; i += 2) {
			System.out.println("hello");
		}
		
		int j = 0;
		for (j = 5; j < 10; j += 2) {
			System.out.println("Hi" + j);
		}
		
		for (int k = 0; k < 10; ++k) {   // 전위나 후위나 10번 출력한다.
			System.out.println("O");
		}
	}

}
